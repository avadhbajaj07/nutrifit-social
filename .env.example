# ==========================================
# NUTRIFITNESS SOCIAL MEDIA AUTOMATION (.env)
# ==========================================

# Port du serveur Express
PORT=5001
APP_TIMEZONE=Europe/Zurich
CLIENT_PORTAL_TOKEN=
CLIENT_PORTAL_HOST=www.sdqure.com
CLIENT_PORTAL_URL=https://www.sdqure.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=nutrifitness

# Supabase server-side persistence (never expose the service-role key in Vite)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Blotato API Configuration (Instagram & Pinterest)
BLOTATO_API_KEY=your_blotato_api_key
BLOTATO_ACCOUNT_ID=your_client_account_id
BLOTATO_IG_SUBACCOUNT_ID=
BLOTATO_PIN_SUBACCOUNT_ID=
BLOTATO_PIN_BOARD_ID=

# OpenAI API Key (Optionnel - Un générateur suisse intelligent est inclus par défaut)
OPENAI_API_KEY=
